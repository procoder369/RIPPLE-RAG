# Service Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-ripple-rag-secret-key-32chars
SERVICE_AUTH_TOKEN=dev-secret-token

# Database Settings
# For PostgreSQL with pgvector: postgresql://postgres:postgres@localhost:5432/ripplerag
# Fallback local sqlite for development: sqlite:///./ripplerag_dev.db
DATABASE_URL=sqlite:///./ripplerag_dev.db

# Vector Dimension (e.g. 384 for all-MiniLM-L6-v2, 768 or 1536 for OpenAI)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM Providers (Mock, Anthropic, OpenAI, or Gemini)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Continuity & Ripple Settings
MAX_GRAPH_DEPTH=4
RIPPLE_IMPACT_THRESHOLD=0.65

